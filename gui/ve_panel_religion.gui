			hbox = { # Section label: Targeted Religious Project
				layoutpolicy_horizontal = expanding
				margin = { 2 15 }
				spacing = 6
				textbox = {
					text = "ve_religious_project_section"
					default_format = "#tooltip_header"
					using = fontsize_large
					align = nobaseline
					autoresize = yes
				}
				icon = {
					texture = "gfx/interface/icons/generic_icons/information.dds"
					size = { 20 20 }
					tooltip = "ve_religious_projects_intro"
					using = tooltip_below
				}
				textbox = { # only while a cancellation backlash blocks a new project
					text = "ve_religious_project_backlash_notice_short"
					default_format = "#N"
					tooltip = "ve_religious_project_backlash_notice"
					using = tooltip_below
					using = fontsize_small
					align = vcenter|nobaseline
					autoresize = yes
					visible = "[GetScriptedGui('ve_religious_project_backlash_gui').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				}
				expand = {}
			}

			hbox = { # A project is running
				layoutpolicy_horizontal = expanding
				margin = { 0 15 }
				visible = "[GetScriptedGui('ve_has_active_religious_project_gui').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				hbox = {
					using = main_bg
					layoutpolicy_horizontal = expanding
					hbox = {
						layoutpolicy_horizontal = expanding
						margin = { 20 12 }
						spacing = 20

						vbox = {
							layoutpolicy_horizontal = expanding
							spacing = 2
							tooltip = "[GetPlayer.GetCustom('ve_religious_project_description')]"
							using = tooltip_below
							textbox = {
								text = "ve_religious_project_active_label"
								default_format = "#instruction"
								using = fontsize_small
								align = nobaseline
								autoresize = yes
							}
							textbox = {
								raw_text = "[GetPlayer.GetCustom('ve_religious_project_name')]"
								default_format = "#tooltip_header"
								using = fontsize_xl
								align = nobaseline
								autoresize = yes
							}
							textbox = {
								raw_text = "[GetPlayer.GetCustom('ve_religious_project_target')]"
								using = fontsize_small
								align = nobaseline
								maximumsize = { 400 -1 }
								elide = right
								autoresize = yes
							}
						}

						vertical_divider = {
							blockoverride "size" {
								size = { 16 100% }
							}
						}

						vbox = {
							layoutpolicy_horizontal = expanding
							spacing = 2
							tooltip = "ve_religious_project_progress_tt"
							using = tooltip_below
							textbox = {
								text = "ve_religious_project_progress"
								default_format = "#tooltippable_name"
								using = fontsize_small
								align = nobaseline
								autoresize = yes
							}
							hbox = {
								spacing = 6
								textbox = {
									raw_text = "[GetPlayer.MakeScope.Var('ve_religious_project_progress').GetValue|0] / 100"
									default_format = "#instruction"
									using = fontsize_xl
									align = nobaseline
									autoresize = yes
								}
								textbox = {
									raw_text = "([GetPlayer.MakeScope.ScriptValue('ve_monthly_religious_project_progress')|+=0])"
									using = fontsize_small
									align = vcenter|nobaseline
									autoresize = yes
								}
							}
							white_progressbar_horizontal = {
								size = { 320 10 }
								blockoverride "values" {
									max = 100
									value = "[GetPlayer.MakeScope.Var('ve_religious_project_progress').GetValue]"
								}
							}
						}

						vertical_divider = {
							blockoverride "size" {
								size = { 16 100% }
							}
						}

						vbox = { # centred against the taller text column
							layoutpolicy_vertical = expanding
							expand = {}
							hbox = { # cancel, then confirm / keep in the same footprint
								spacing = 6
								button = {
									using = default_button_action
									size = { 200 28 }
									text = "ve_cancel_religious_project_button"
									onclick = "[GetVariableSystem.Set('confirm_cancel_religious_project', 'yes')]"
									enabled = "[GetScriptedGui('ve_cancel_religious_project_gui').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
									visible = "[Not(GetVariableSystem.Exists('confirm_cancel_religious_project'))]"
									tooltip = "ve_religious_project_cancel_warning"
									using = tooltip_below
								}
								button = {
									using = default_button_action
									size = { 200 28 }
									text = "ve_confirm_cancel_button"
									onclick = "[GetVariableSystem.Clear('confirm_cancel_religious_project')]"
									onclick = "[GetScriptedGui('ve_cancel_religious_project_gui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
									visible = "[GetVariableSystem.Exists('confirm_cancel_religious_project')]"
									tooltip = "ve_religious_project_cancel_warning"
									using = tooltip_below
								}
								button = {
									using = default_button_action
									size = { 140 28 }
									text = "ve_keep_project_button"
									onclick = "[GetVariableSystem.Clear('confirm_cancel_religious_project')]"
									visible = "[GetVariableSystem.Exists('confirm_cancel_religious_project')]"
								}
							}
							expand = {}
						}
					}
				}
			}

			hbox = { # No project running: what this model may start, and how
				layoutpolicy_horizontal = expanding
				margin = { 0 15 }
				visible = "[GetScriptedGui('ve_has_no_active_religious_project_gui').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				hbox = {
					using = main_bg
					layoutpolicy_horizontal = expanding
					hbox = {
						layoutpolicy_horizontal = expanding
						margin = { 16 10 }
						spacing = 16
						tooltip = "[GetPlayer.GetCustom('ve_religion_model_project_description')]"
						using = tooltip_below

						vbox = { # one wrapper for all four variants: the hidden ones take no
							# height, so the row pays its spacing once, not four times
							layoutpolicy_vertical = expanding
							expand = {}
							icon = {
								texture = "gfx/interface/icons/generic_icons/conversion.dds"
								size = { 44 44 }
								visible = "[EqualTo_CFixedPoint(GetPlayer.MakeScope.Var('ve_religious_model').GetValue, '(CFixedPoint)1')]"
							}
							icon = {
								texture = "gfx/interface/icons/generic_icons/population_loyalist.dds"
								size = { 44 44 }
								visible = "[EqualTo_CFixedPoint(GetPlayer.MakeScope.Var('ve_religious_model').GetValue, '(CFixedPoint)2')]"
							}
							icon = {
								texture = "gfx/interface/icons/map_mode_icons/religions.dds"
								size = { 44 44 }
								visible = "[EqualTo_CFixedPoint(GetPlayer.MakeScope.Var('ve_religious_model').GetValue, '(CFixedPoint)3')]"
							}
							icon = {
								texture = "gfx/interface/icons/invention_icons/analytical_philosophy.dds"
								size = { 44 44 }
								visible = "[EqualTo_CFixedPoint(GetPlayer.MakeScope.Var('ve_religious_model').GetValue, '(CFixedPoint)4')]"
							}
							expand = {}
						}

						vbox = {
							spacing = 2
							textbox = {
								raw_text = "[GetPlayer.GetCustom('ve_religion_model_project_name')]"
								default_format = "#tooltip_header"
								using = fontsize_xl
								align = nobaseline
								autoresize = yes
							}
							textbox = {
								raw_text = "[GetPlayer.GetCustom('ve_religion_model_project_cost')]"
								using = fontsize_small
								align = nobaseline
								autoresize = yes
							}
						}

						textbox = {
							layoutpolicy_horizontal = expanding
							raw_text = "[GetPlayer.GetCustom('ve_religion_model_project_short')]"
							using = fontsize_small
							align = nobaseline
							maximumsize = { 520 54 }
							multiline = yes
							autoresize = yes
						}

						vertical_divider = {
							blockoverride "size" {
								size = { 16 100% }
							}
						}

						textbox = {
							text = "ve_religious_project_start_instruction_short"
							default_format = "#instruction"
							using = fontsize_small
							align = nobaseline
							maximumsize = { 400 54 }
							multiline = yes
							autoresize = yes
							visible = "[Not(EqualTo_CFixedPoint(GetPlayer.MakeScope.Var('ve_religious_model').GetValue, '(CFixedPoint)3'))]"
						}
					}
				}
			}

			expand = {}
		}
	}
}
