				margin = { 2 15 }
				spacing = 6
				textbox = {
					text = "ve_religious_models"
					default_format = "#tooltip_header"
					using = fontsize_large
					align = nobaseline
					autoresize = yes
				}
				icon = {
					texture = "gfx/interface/icons/generic_icons/information.dds"
					size = { 20 20 }
					tooltip = "ve_religious_models_help"
					using = tooltip_below
				}
				expand = {}
			}

			hbox = { # Four models side by side, read-only
				layoutpolicy_horizontal = expanding
				margin = { 0 15 }
				spacing = 10

				vbox = { # Confessional State
					using = main_bg
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					minimumsize = { 0 116 }
					hbox = {
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding
						margin = { 12 8 }
						spacing = 8
						tooltip = "ve_confessional_state_desc"
						using = tooltip_below
						vbox = { # centred, and still contributes its size to the row
							layoutpolicy_vertical = expanding
							expand = {}
							icon = {
								texture = "gfx/interface/icons/law_icons/state_religion.dds"
								size = { 40 40 }
							}
							expand = {}
						}
						vbox = {
							layoutpolicy_horizontal = expanding
							layoutpolicy_vertical = expanding
							spacing = 2
							hbox = {
								spacing = 4
								icon = {
									texture = "gfx/interface/icons/generic_icons/green_checkmark.dds"
									size = { 16 16 }
									visible = "[EqualTo_CFixedPoint(GetPlayer.MakeScope.Var('ve_religious_model').GetValue, '(CFixedPoint)1')]"
								}
								textbox = {
									text = "ve_confessional_state_name"
									default_format = "#tooltip_header"
									using = fontsize_large
									align = nobaseline
									autoresize = yes
								}
								expand = {}
							}
							textbox = {
								text = "ve_confessional_state_short"
								using = fontsize_small
								align = nobaseline
								maximumsize = { 240 52 }
								multiline = yes
								autoresize = yes
							}
							expand = {}
							textbox = {
								text = "ve_religious_model_active_footer"
								default_format = "#P"
								using = fontsize_small
								align = nobaseline
								autoresize = yes
								visible = "[EqualTo_CFixedPoint(GetPlayer.MakeScope.Var('ve_religious_model').GetValue, '(CFixedPoint)1')]"
							}
							textbox = {
								text = "ve_confessional_state_unlocks"
								default_format = "#instruction"
								using = fontsize_small
								align = nobaseline
								maximumsize = { 240 -1 }
								elide = right
								autoresize = yes
								visible = "[Not(EqualTo_CFixedPoint(GetPlayer.MakeScope.Var('ve_religious_model').GetValue, '(CFixedPoint)1'))]"
							}
						}
					}
				}

				vbox = { # Freedom of Conscience
					using = main_bg
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					minimumsize = { 0 116 }
					hbox = {
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding
						margin = { 12 8 }
						spacing = 8
						tooltip = "ve_freedom_state_desc"
						using = tooltip_below
						vbox = { # centred, and still contributes its size to the row
							layoutpolicy_vertical = expanding
							expand = {}
							icon = {
								texture = "gfx/interface/icons/law_icons/freedom_of_conscience.dds"
								size = { 40 40 }
							}
							expand = {}
						}
						vbox = {
							layoutpolicy_horizontal = expanding
							layoutpolicy_vertical = expanding
							spacing = 2
							hbox = {
								spacing = 4
								icon = {
									texture = "gfx/interface/icons/generic_icons/green_checkmark.dds"
									size = { 16 16 }
									visible = "[EqualTo_CFixedPoint(GetPlayer.MakeScope.Var('ve_religious_model').GetValue, '(CFixedPoint)2')]"
								}
								textbox = {
									text = "ve_freedom_state_name"
									default_format = "#tooltip_header"
									using = fontsize_large
									align = nobaseline
									autoresize = yes
								}
								expand = {}
							}
							textbox = {
								text = "ve_freedom_state_short"
								using = fontsize_small
								align = nobaseline
								maximumsize = { 240 52 }
								multiline = yes
								autoresize = yes
							}
							expand = {}
							textbox = {
								text = "ve_religious_model_active_footer"
								default_format = "#P"
								using = fontsize_small
								align = nobaseline
								autoresize = yes
								visible = "[EqualTo_CFixedPoint(GetPlayer.MakeScope.Var('ve_religious_model').GetValue, '(CFixedPoint)2')]"
							}
							textbox = {
								text = "ve_freedom_state_unlocks"
								default_format = "#instruction"
								using = fontsize_small
								align = nobaseline
								maximumsize = { 240 -1 }
								elide = right
								autoresize = yes
								visible = "[Not(EqualTo_CFixedPoint(GetPlayer.MakeScope.Var('ve_religious_model').GetValue, '(CFixedPoint)2'))]"
							}
						}
					}
				}

				vbox = { # Total Separation
					using = main_bg
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					minimumsize = { 0 116 }
					hbox = {
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding
						margin = { 12 8 }
						spacing = 8
						tooltip = "ve_separation_state_desc"
						using = tooltip_below
						vbox = { # centred, and still contributes its size to the row
							layoutpolicy_vertical = expanding
							expand = {}
							icon = {
								texture = "gfx/interface/icons/law_icons/total_separation.dds"
								size = { 40 40 }
							}
							expand = {}
						}
						vbox = {
							layoutpolicy_horizontal = expanding
							layoutpolicy_vertical = expanding
							spacing = 2
							hbox = {
								spacing = 4
								icon = {
									texture = "gfx/interface/icons/generic_icons/green_checkmark.dds"
									size = { 16 16 }
									visible = "[EqualTo_CFixedPoint(GetPlayer.MakeScope.Var('ve_religious_model').GetValue, '(CFixedPoint)3')]"
								}
								textbox = {
									text = "ve_separation_state_name"
									default_format = "#tooltip_header"
									using = fontsize_large
									align = nobaseline
									autoresize = yes
								}
								expand = {}
							}
							textbox = {
								text = "ve_separation_state_short"
								using = fontsize_small
								align = nobaseline
								maximumsize = { 240 52 }
								multiline = yes
								autoresize = yes
							}
							expand = {}
							textbox = {
								text = "ve_religious_model_active_footer"
								default_format = "#P"
								using = fontsize_small
								align = nobaseline
								autoresize = yes
								visible = "[EqualTo_CFixedPoint(GetPlayer.MakeScope.Var('ve_religious_model').GetValue, '(CFixedPoint)3')]"
							}
							textbox = {
								text = "ve_separation_state_unlocks"
								default_format = "#instruction"
								using = fontsize_small
								align = nobaseline
								maximumsize = { 240 -1 }
								elide = right
								autoresize = yes
								visible = "[Not(EqualTo_CFixedPoint(GetPlayer.MakeScope.Var('ve_religious_model').GetValue, '(CFixedPoint)3'))]"
							}
						}
					}
				}

				vbox = { # State Atheism
					using = main_bg
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					minimumsize = { 0 116 }
					hbox = {
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding
						margin = { 12 8 }
						spacing = 8
						tooltip = "ve_atheism_state_desc"
						using = tooltip_below
						vbox = { # centred, and still contributes its size to the row
							layoutpolicy_vertical = expanding
							expand = {}
							icon = {
								texture = "gfx/interface/icons/law_icons/state_atheism.dds"
								size = { 40 40 }
							}
							expand = {}
						}
						vbox = {
							layoutpolicy_horizontal = expanding
							layoutpolicy_vertical = expanding
							spacing = 2
							hbox = {
								spacing = 4
								icon = {
									texture = "gfx/interface/icons/generic_icons/green_checkmark.dds"
									size = { 16 16 }
									visible = "[EqualTo_CFixedPoint(GetPlayer.MakeScope.Var('ve_religious_model').GetValue, '(CFixedPoint)4')]"
								}
								textbox = {
									text = "ve_atheism_state_name"
									default_format = "#tooltip_header"
									using = fontsize_large
									align = nobaseline
									autoresize = yes
								}
								expand = {}
							}
							textbox = {
								text = "ve_atheism_state_short"
								using = fontsize_small
								align = nobaseline
								maximumsize = { 240 52 }
								multiline = yes
								autoresize = yes
							}
							expand = {}
							textbox = {
								text = "ve_religious_model_active_footer"
								default_format = "#P"
								using = fontsize_small
								align = nobaseline
								autoresize = yes
								visible = "[EqualTo_CFixedPoint(GetPlayer.MakeScope.Var('ve_religious_model').GetValue, '(CFixedPoint)4')]"
							}
							textbox = {
								text = "ve_atheism_state_unlocks"
								default_format = "#instruction"
								using = fontsize_small
								align = nobaseline
								maximumsize = { 240 -1 }
								elide = right
								autoresize = yes
								visible = "[Not(EqualTo_CFixedPoint(GetPlayer.MakeScope.Var('ve_religious_model').GetValue, '(CFixedPoint)4'))]"
							}
						}
					}
				}
			}

			hbox = { # Section label: Doctrines and Programs
				layoutpolicy_horizontal = expanding
				margin = { 2 15 }
				spacing = 6
				textbox = {
					text = "ve_aspects"
					default_format = "#tooltip_header"
					using = fontsize_large
					align = nobaseline
					autoresize = yes
				}
				icon = {
					texture = "gfx/interface/icons/generic_icons/information.dds"
					size = { 20 20 }
					tooltip = "ve_religious_programs_help"
					using = tooltip_below
				}
				textbox = { # only while another program is still being implemented
					text = "ve_religious_program_strain_notice_short"
					default_format = "#N"
					tooltip = "ve_religious_program_strain_notice"
