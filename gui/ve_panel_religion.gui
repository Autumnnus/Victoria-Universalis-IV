					align = vcenter|nobaseline
					autoresize = yes
					visible = "[GetScriptedGui('ve_religious_program_strain_gui').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				}
				expand = {}
			}

			hbox = { # All eight programs in one row
				layoutpolicy_horizontal = expanding
				margin = { 0 15 }
				spacing = 8

				ve_religion_program_card = {
					blockoverride "card_tooltip" { tooltip = "ve_religious_program_1_tt" }
					blockoverride "card_icon" {
						textbox = {
							raw_text = "@[GetPlayer.GetCustom('ve_religion_aspect_1')]!"
