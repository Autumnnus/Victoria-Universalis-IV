types ve_gui_panel_types
{
	# Religion page. One screen: no tabs, no scrolling. Every section is packed
	# horizontally instead of stacked, so the page fits the fullscreen content area
	# down to 1366x768 (~630 px usable; this page needs ~580).
	#
	# Layout contract, shared with gui/ve_panel_culture.gui - keep both in step:
	#   1. A card shows an icon, a name and at most one short line. Every full
	#      modifier list lives in that card's tooltip (*_desc / *_tt localization).
	#   2. Current state is stated twice: in the summary strip, and on the card as a
	#      checkmark plus a footer that replaces the action button.
	#   3. A section is one label line with an information icon whose tooltip is that
	#      section's help paragraph. Nothing explanatory is printed on the page; only
	#      conditional red notices (strain, backlash), and only while they are live.
	#   4. Nothing may grow vertically with its content: long text is elided or
	#      capped with maximumsize, because one tall card brings back the scrollbar.
	#
	# Religious Model is law-driven (lawgroup_church_and_state), so the model row is a
	# read-only comparison, not a set of buttons. The only actions on this page are
	# adopting a Program and cancelling a running Religious Project; a project is
	# *started* from an owned state's panel.

	# One meter in the summary strip: label, value / max, signed monthly delta, bar,
	# and an optional status line.
	type ve_religion_meter = vbox {
		spacing = 2
		block "meter_tooltip" {}
		using = tooltip_below

		block "meter_label" {}
		hbox = {
			spacing = 6
			block "meter_value" {}
		}
		block "meter_bar" {}
		block "meter_extra" {}
	}

	# One Doctrine/Program slot. Eight sit in a single row, so a card is ~150 px wide
	# at 1366 and ~215 px at 1920. Everything inside stretches with the frame: the
	# action is layout-expanding rather than a fixed width, and the cost sits on its
	# own line so the button label stays a single verb.
	type ve_religion_program_card = vbox {
		using = main_bg
		layoutpolicy_horizontal = expanding
		layoutpolicy_vertical = expanding
		minimumsize = { 150 134 }

		vbox = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
			margin = { 10 8 }
			spacing = 4
			block "card_tooltip" {
				tooltip = "ve_religious_program_1_tt"
			}
			using = tooltip_below

			block "card_icon" {}
			block "card_name" {}
			block "card_cost" {}
			expand = {}
			block "card_action" {}
		}
	}

	type ve_panel_religion = vbox {
		layoutpolicy_horizontal = expanding
		layoutpolicy_vertical = expanding

		vbox = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
			spacing = 8

			hbox = { # Summary strip: state religion, then the three meters
				layoutpolicy_horizontal = expanding
				margin = { 0 12 }
				spacing = 10

				hbox = {
					using = main_bg
					layoutpolicy_horizontal = preferred
					hbox = {
						margin = { 14 8 }
						spacing = 10
						vbox = { # centred, and still contributes its size to the row
							layoutpolicy_vertical = expanding
							expand = {}
							icon = {
								texture = "[GetPlayer.GetStateReligion.GetTexture]"
								size = { 52 52 }
							}
							expand = {}
						}
						vbox = {
							spacing = 2
							textbox = {
								text = "ve_state_religion_label"
								default_format = "#instruction"
								using = fontsize_small
								align = nobaseline
								autoresize = yes
							}
							textbox = {
								raw_text = "#v [GetPlayer.GetStateReligion.GetName]#!"
								using = fontsize_xl
								align = nobaseline
								maximumsize = { 260 -1 }
								elide = right
								autoresize = yes
							}
							hbox = {
								spacing = 6
								icon = {
									size = { 20 20 }
									texture = "gfx/interface/icons/law_icons/state_religion.dds"
									visible = "[EqualTo_CFixedPoint(GetPlayer.MakeScope.Var('ve_religious_model').GetValue, '(CFixedPoint)1')]"
								}
								icon = {
									size = { 20 20 }
									texture = "gfx/interface/icons/law_icons/freedom_of_conscience.dds"
									visible = "[EqualTo_CFixedPoint(GetPlayer.MakeScope.Var('ve_religious_model').GetValue, '(CFixedPoint)2')]"
								}
								icon = {
									size = { 20 20 }
									texture = "gfx/interface/icons/law_icons/total_separation.dds"
									visible = "[EqualTo_CFixedPoint(GetPlayer.MakeScope.Var('ve_religious_model').GetValue, '(CFixedPoint)3')]"
								}
								icon = {
									size = { 20 20 }
									texture = "gfx/interface/icons/law_icons/state_atheism.dds"
									visible = "[EqualTo_CFixedPoint(GetPlayer.MakeScope.Var('ve_religious_model').GetValue, '(CFixedPoint)4')]"
								}
								textbox = {
									raw_text = "#P [GetPlayer.GetCustom('ve_religious_model_name')]#!"
									using = fontsize_large
									align = vcenter|nobaseline
									maximumsize = { 234 -1 }
									elide = right
									autoresize = yes
								}
							}
						}
					}
				}

				hbox = {
					using = main_bg
					layoutpolicy_horizontal = expanding
					hbox = {
						layoutpolicy_horizontal = expanding
						margin = { 16 8 }
						spacing = 24

						ve_religion_meter = { # Religious Settlement
							blockoverride "meter_tooltip" { tooltip = "ve_piety_tt" }
							blockoverride "meter_label" {
								hbox = {
									spacing = 4
									icon = {
										texture = "gfx/interface/icons/generic_icons/conversion.dds"
										size = { 20 20 }
									}
									textbox = {
										raw_text = "[GetPlayer.GetCustom('ve_religious_resource_name')]"
										default_format = "#tooltippable_name"
										using = fontsize_large
										align = vcenter|nobaseline
										autoresize = yes
									}
								}
							}
							blockoverride "meter_value" {
								textbox = {
									raw_text = "[GetPlayer.MakeScope.Var('piety_bar_point').GetValue|0] / 100"
									default_format = "#instruction"
									using = fontsize_xl
									align = nobaseline
									autoresize = yes
								}
								textbox = {
									raw_text = "([GetPlayer.MakeScope.ScriptValue('ve_monthly_religious_state')|+=0])"
									using = fontsize_small
									align = vcenter|nobaseline
									autoresize = yes
								}
							}
							blockoverride "meter_bar" {
								white_progressbar_horizontal = {
									size = { 150 8 }
									blockoverride "values" {
										max = 100
										value = "[GetPlayer.MakeScope.Var('piety_bar_point').GetValue]"
									}
								}
							}
							blockoverride "meter_extra" { # tier badge; the middle band shows nothing
								textbox = {
									text = "ve_settlement_tier_high"
									default_format = "#P"
									using = fontsize_small
									align = nobaseline
									maximumsize = { 240 -1 }
									elide = right
									autoresize = yes
									visible = "[GreaterThanOrEqualTo_CFixedPoint(GetPlayer.MakeScope.Var('piety_bar_point').GetValue, '(CFixedPoint)75')]"
								}
								textbox = {
									text = "ve_settlement_tier_low"
									default_format = "#N"
									using = fontsize_small
									align = nobaseline
									maximumsize = { 240 -1 }
									elide = right
									autoresize = yes
									visible = "[LessThanOrEqualTo_CFixedPoint(GetPlayer.MakeScope.Var('piety_bar_point').GetValue, '(CFixedPoint)25')]"
								}
							}
						}

						ve_religion_meter = { # Piety Reform
							blockoverride "meter_tooltip" { tooltip = "ve_piety_reform_tt" }
							blockoverride "meter_label" {
								hbox = {
									spacing = 4
									icon = {
										texture = "gfx/interface/icons/central_identity_pillars_icons/religious.dds"
										size = { 20 20 }
									}
									textbox = {
										text = "ve_piety_reform"
										default_format = "#tooltippable_name"
										using = fontsize_large
										align = vcenter|nobaseline
										autoresize = yes
									}
								}
							}
							blockoverride "meter_value" {
								textbox = {
									raw_text = "[GetPlayer.MakeScope.Var('piety_reform_point').GetValue|0] / 500"
									default_format = "#instruction"
									using = fontsize_xl
									align = nobaseline
									autoresize = yes
								}
								textbox = {
									raw_text = "([GetPlayer.MakeScope.ScriptValue('ve_monthly_piety_reform')|+=0])"
									using = fontsize_small
									align = vcenter|nobaseline
									autoresize = yes
								}
							}
							blockoverride "meter_bar" {
								white_progressbar_horizontal = {
									size = { 150 8 }
									blockoverride "values" {
										max = 500
										value = "[GetPlayer.MakeScope.Var('piety_reform_point').GetValue]"
									}
								}
							}
							blockoverride "meter_extra" {
								textbox = { # only while a program is still being implemented
									text = "ve_religious_program_strain_notice_short"
									default_format = "#N"
									using = fontsize_small
									align = nobaseline
									maximumsize = { 240 -1 }
									elide = right
									autoresize = yes
									visible = "[GetScriptedGui('ve_religious_program_strain_gui').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								}
							}
						}

						ve_religion_meter = { # Religious Project
							blockoverride "meter_tooltip" { tooltip = "ve_religious_project_progress_tt" }
							blockoverride "meter_label" {
								hbox = {
									spacing = 4
									icon = {
										texture = "gfx/interface/icons/generic_icons/national_awakening.dds"
										size = { 20 20 }
									}
									textbox = {
										text = "ve_religious_project_progress"
										default_format = "#tooltippable_name"
										using = fontsize_large
										align = vcenter|nobaseline
										autoresize = yes
									}
								}
							}
							blockoverride "meter_value" {
								textbox = {
									raw_text = "[GetPlayer.MakeScope.Var('ve_religious_project_progress').GetValue|0] / 100"
									default_format = "#instruction"
									using = fontsize_xl
									align = nobaseline
									autoresize = yes
									visible = "[GetScriptedGui('ve_has_active_religious_project_gui').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								}
								textbox = {
									raw_text = "([GetPlayer.MakeScope.ScriptValue('ve_monthly_religious_project_progress')|+=0])"
									using = fontsize_small
									align = vcenter|nobaseline
									autoresize = yes
									visible = "[GetScriptedGui('ve_has_active_religious_project_gui').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								}
								textbox = {
									raw_text = "[GetPlayer.GetCustom('ve_religious_project_status')]"
									default_format = "#instruction"
									using = fontsize_xl
									align = nobaseline
									autoresize = yes
									visible = "[GetScriptedGui('ve_has_no_active_religious_project_gui').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								}
							}
							blockoverride "meter_bar" {
								white_progressbar_horizontal = {
									size = { 150 8 }
									blockoverride "values" {
										max = 100
										value = "[GetPlayer.MakeScope.Var('ve_religious_project_progress').GetValue]"
									}
								}
							}
							blockoverride "meter_extra" {
								textbox = {
									raw_text = "[GetPlayer.GetCustom('ve_religious_project_target')]"
									using = fontsize_small
									align = nobaseline
									maximumsize = { 240 -1 }
									elide = right
									autoresize = yes
									visible = "[GetScriptedGui('ve_has_active_religious_project_gui').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								}
								textbox = { # only while a cancellation backlash blocks a new project
									text = "ve_religious_project_backlash_notice_short"
									default_format = "#N"
									using = fontsize_small
									align = nobaseline
									maximumsize = { 240 -1 }
									elide = right
									autoresize = yes
									visible = "[GetScriptedGui('ve_religious_project_backlash_gui').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								}
							}
						}
