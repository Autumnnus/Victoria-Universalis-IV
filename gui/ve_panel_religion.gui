types
ve_gui_panel_types
{
	type
	ve_panel_religion = vbox
	{
		layoutpolicy_horizontal = expanding
		layoutpolicy_vertical = expanding
		vbox = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
			hbox = {	#Top Section
				layoutpolicy_horizontal = expanding
				margin = {
					0
					20
				}
				hbox = {	#Top-Left
					using = main_bg
					layoutpolicy_horizontal = preferred
					layoutpolicy_vertical = expanding
					vbox = {
						spacing = 10
						margin = {
							30
							10
						}
						icon = {
							texture = "[GetPlayer.GetStateReligion.GetTexture]"
							size = {
								120
								120
							}
						}
						textbox = {
							# text = "#v [GetPlayer.GetStateReligion.GetName]#!"
							raw_text = "[GetPlayer.GetCustom('ve_religious_model_name')]"
							using = fontsize_xxl
							align = nobaseline
							elide = left
							autoresize = yes
						}
					}
				}
				hbox = {
					#Religion Info
					using = main_bg
					 layoutpolicy_horizontal = expanding
					hbox = {
						margin = {
							0
							20
						}
						spacing = 10
						 layoutpolicy_horizontal = expanding
						vbox = {
							spacing = 10
							visible = "[GetScriptedGui('ve_show_religious_project_topbar').IsShown(GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
							tooltip = "ve_piety_reform_tt"
							textbox = {
								text = "ve_piety_reform"
								default_format = "#tooltippable_name"
								using = fontsize_xxl
								align = nobaseline
								elide = left
								autoresize = yes
							}
							textbox = {
								text = "[GetPlayer.MakeScope.Var('piety_reform_point').GetValue]"
								default_format = "#instruction"
								using = fontsize_xxl
								align = nobaseline
								elide = left
								autoresize = yes
							}
							white_progressbar_horizontal = {
								size = {
									130
									15
								}
								tooltip = "ve_piety_reform_tt"
								blockoverride
								"values"
								{
									min = 0
									max = 500
									value = "[GetPlayer.MakeScope.Var('piety_reform_point').GetValue]"
								}
							}
						}
						vbox = {
							spacing = 10							
							tooltip = "ve_piety_tt"
							textbox = {
								raw_text = "[GetPlayer.GetCustom('ve_religious_resource_name')]"
								default_format = "#tooltippable_name"
								using = fontsize_xxl
								align = nobaseline
								elide = left
								autoresize = yes
							}
							textbox = {
								text = "[GetPlayer.MakeScope.Var('piety_bar_point').GetValue]"
								default_format = "#instruction"
								using = fontsize_xxl
								align = nobaseline
								elide = left
								autoresize = yes
							}
							white_progressbar_horizontal = {
								size = {
									80
									15
								}
								tooltip = "ve_piety_tt"
								blockoverride
								"values"
								{
									min = 0
									max = 100
									value = "[GetPlayer.MakeScope.Var('piety_bar_point').GetValue]"
								}
							}
						}
						vbox = {
							spacing = 10
							visible = "[GetScriptedGui('ve_show_religious_project_topbar').IsShown(GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
							tooltip = "ve_religious_project_progress_tt"
							textbox = {
								text = "ve_religious_project_progress"
								default_format = "#tooltippable_name"
								using = fontsize_xxl
								align = nobaseline
								elide = left
								autoresize = yes
							}
							textbox = {
								raw_text = "[GetPlayer.GetCustom('ve_religious_project_status')]"
								default_format = "#instruction"
								using = fontsize_xxl
								align = nobaseline
								elide = left
								autoresize = yes
							}
							white_progressbar_horizontal = {
								size = {
									130
									15
								}
								tooltip = "ve_religious_project_progress_tt"
								blockoverride
								"values"
								{
									min = 0
									max = 100
									value = "[GetPlayer.MakeScope.Var('ve_religious_project_progress').GetValue]"
								}
							}
						}
						vbox = {
							layoutpolicy_vertical = expanding
							spacing = 20
							tooltip = "[GetScriptedGui('ve_passive_bonus_tooltip').BuildTooltip(GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
							margin = {
								30
								10
							}
							textbox = {
								text = "ve_religion_passive_text"
								default_format = "#tooltippable_name"
								using = fontsize_xxl
								align = nobaseline
								elide = left
								autoresize = yes
							}
							hbox = {
								textbox = {
									raw_text = "@[GetPlayer.GetCustom('religion_aspect_9')]!"
									fontsize = 60
									align = center|nobaseline
									parentanchor = vcenter
									size = {
										100%
										100%
									}
								}
							}
						}
					}
				}
			}
			vbox = {
				#Aspects
				spacing = 15
				layoutpolicy_horizontal = expanding
				header_pattern = {
					layoutpolicy_horizontal = expanding
					blockoverride
					"header_text"
					{
						text = "ve_aspects"
						default_format = "#tooltip_header"
					}
					blockoverride
					"button_close"
					{
						visible = no
					}
				}
				vbox = {
					#Aspect Modifiers
					using = main_bg
					layoutpolicy_horizontal = expanding
					hbox = {
						layoutpolicy_horizontal = expanding
						margin = {
