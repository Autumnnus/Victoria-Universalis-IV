types
ve_gui_panel_types
{
	type
	ve_panel_ideas = vbox
	{
		layoutpolicy_horizontal = expanding
		layoutpolicy_vertical = expanding
		vbox = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
			hbox = {
				#National Ideas
				layoutpolicy_horizontal = expanding
				margin = {
					0
					10
				}
				hbox = {
					spacing = 30					
					hbox = {
						layoutpolicy_horizontal = expanding
						spacing = 20
						vbox = {
							layoutpolicy_horizontal = expanding
							hbox = {
								large_flag = {
									datacontext = "[GetPlayer]"
								}
							}
							vbox = {
								spacing = 8
								tooltip = "ve_national_insight_tt"
								textbox = {
									text = "ve_idea_points"	
									using = fontsize_xxl
									autoresize = yes
								}
								textbox = {
									text = "[GetPlayer.MakeScope.Var('idea_point_pool').GetValue]"
									default_format = "#positive_value"
									using = fontsize_xxl
									autoresize = yes
								}
								white_progressbar_horizontal = {
									size = {
										80
										15
									}
									tooltip = "ve_national_insight_tt"
									blockoverride
									"values"
									{
										max = 1000
										value = "[GetPlayer.MakeScope.Var('idea_point_pool').GetValue]"
									}
								}
							}
						}
						vbox = {
							layoutpolicy_horizontal = expanding
								spacing = 2
								white_progressbar_horizontal = {
									size = {
										50
										15
									}
									tooltip = "embrace_idea_tt"
									blockoverride
									"values"
									{
										# max = "[GetPlayer.MakeScope.Var('idea_group_cap').GetValue]"
										max = 7
										value = "[GetPlayer.MakeScope.Var('idea_group_unlocked').GetValue]"
									}
								}

								textbox = {
									text = "ve_total_ideas"
									using = fontsize_xl
									autoresize = yes
								}
								textbox = {
									text = "ve_max_idea_text"
									using = fontsize_xsmall
									autoresize = yes
								}
						}
					}
					hbox = {
						using = main_bg
						margin = {
							20
							20
						}
						vbox = {
							spacing = 5
							hbox = {	#Title
								textbox = {
									text = "[GetPlayer.GetAdjective]"
									default_format = "#instruction"
									using = fontsize_xxl
									align = nobaseline
									elide = left
									autoresize = yes
								}
								textbox = {
									text = "ve_national_ideas"
									default_format = "#tooltippable_name"
									using = fontsize_xxl
									align = nobaseline
									elide = left
									autoresize = yes
								}
							}
							hbox = {
								#Ideas
								# spacing = 20
								hbox = {
									widget = {
										size = {
											90
											90
										}
										textbox = {
											text = "@[Concatenate(GetPlayer.GetTagName, '_idea_icon_1')]!"
											using = main_bg
											default_format = "#tooltip_header"
											fontsize = 60
											align = center|nobaseline
											parentanchor = vcenter
											visible = "[GetScriptedGui('ve_national_idea_1_active').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
											size = {
												100%
												100%
											}
											tooltip = "[GetScriptedGui('ve_national_idea_1').ExecuteTooltip( GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
											using = tooltip_above
										}
											textbox = {
												text = "@[Concatenate(GetPlayer.GetTagName, '_idea_icon_1_black')]!"
