types
ve_gui_panel_types
{
	type
	ve_panel_ideas = vbox
	{
		layoutpolicy_horizontal = expanding
		layoutpolicy_vertical = expanding
		vbox = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
			hbox = {
				#National Ideas
				layoutpolicy_horizontal = expanding
				margin = {
					0
					10
				}
				hbox = {
					spacing = 30					
					hbox = {
						layoutpolicy_horizontal = expanding
						spacing = 20
						vbox = {
							layoutpolicy_horizontal = expanding
							hbox = {
								large_flag = {
									datacontext = "[GetPlayer]"
								}
							}
							vbox = {
								spacing = 8
								tooltip = "ve_national_insight_tt"
								hbox = {
									spacing = 4
									icon = {
										texture = "gfx/interface/icons/generic_icons/innovation.dds"
										size = { 20 20 }
									}
									textbox = {
										text = "ve_idea_points"
										using = fontsize_xxl
										align = vcenter|nobaseline
										autoresize = yes
									}
								}
								textbox = {
									text = "[GetPlayer.MakeScope.Var('idea_point_pool').GetValue]"
									default_format = "#positive_value"
									using = fontsize_xxl
									autoresize = yes
								}
								white_progressbar_horizontal = {
									size = {
										80
										15
									}
									tooltip = "ve_national_insight_tt"
									blockoverride
									"values"
									{
										max = 1000
										value = "[GetPlayer.MakeScope.Var('idea_point_pool').GetValue]"
									}
								}
							}
						}
						vbox = {
							layoutpolicy_horizontal = expanding
								spacing = 2
								tooltip = "embrace_idea_tt"
								white_progressbar_horizontal = {
									size = {
										50
										15
									}
									tooltip = "embrace_idea_tt"
									blockoverride
									"values"
									{
										# max = "[GetPlayer.MakeScope.Var('idea_group_cap').GetValue]"
										max = 7
										value = "[GetPlayer.MakeScope.Var('idea_group_unlocked').GetValue]"
									}
								}

								textbox = {
									text = "ve_total_ideas"
									using = fontsize_xl
									autoresize = yes
								}
								textbox = {
									text = "ve_max_idea_text"
									using = fontsize_xsmall
									autoresize = yes
								}
						}
					}
					hbox = {
						using = main_bg
						margin = {
							20
							20
						}
						vbox = {
							spacing = 5
							hbox = {	#Title
								textbox = {
									text = "[GetPlayer.GetAdjective]"
									default_format = "#instruction"
									using = fontsize_xxl
									align = nobaseline
									elide = left
									autoresize = yes
								}
								textbox = {
									text = "ve_national_ideas"
									default_format = "#tooltippable_name"
									using = fontsize_xxl
									align = nobaseline
									elide = left
									autoresize = yes
								}
							}
							hbox = {
