												default_format = "#lore"
												alpha = 0.35
											fontsize = 60
											align = center|nobaseline
											parentanchor = vcenter
											visible = "[Not(GetScriptedGui('ve_national_idea_1_active').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
