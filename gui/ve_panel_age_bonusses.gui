types ve_gui_panel_types
{
    type ve_panel_age_bonusses = vbox {
		layoutpolicy_horizontal = expanding
		layoutpolicy_vertical = expanding
				vbox = {
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					vbox = {	#Up
						spacing =  10
						layoutpolicy_horizontal = expanding
						hbox = {	#Age Info
							layoutpolicy_horizontal = fixed
							using = main_bg
							margin = {
								200
								20
							}
							hbox = {	#Sections - AGE 1	
								visible = "[GetScriptedGui('ve_age_1').IsShown(GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
								vbox = {	#Middle Section
									spacing = 10
									vbox = {
										header_pattern = {
											layoutpolicy_horizontal = expanding
											blockoverride
											"header_text"
											{
												text = "ve_age_of_victoria_title"
												default_format = "#tooltip_header"
											}
											blockoverride
											"button_close"
											{
												visible = no
											}
										}
										hbox = {											
											vbox = {	#Left Age
												spacing = 50
												layoutpolicy_vertical = fixed
												widget = {								
												}							
												widget = {
													size = { 75 75 }
													tooltip = "ve_victorian_age_icon_p_tt"
													icon = {
														size = { 100% 100% }
														texture = "gfx/interface/ve_age/victorian_age_icon.dds"
														using = default_fade_in_out
													}
												}
												widget = {
													size = { 75 75 }
													tooltip = "ve_imperialism_age_icon_n_tt"
													icon = {
														size = { 100% 100% }
														texture = "gfx/interface/ve_age/imperialism_age_icon_black.dds"
														using = default_fade_in_out
													}
												}
											}
											vbox = {
												icon = {
													texture = "gfx/interface/ve_age/victoria_age.dds"
													size = {
