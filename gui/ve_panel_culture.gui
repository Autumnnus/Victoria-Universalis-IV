			hbox = { # A project is running
				layoutpolicy_horizontal = expanding
				margin = { 0 15 }
				visible = "[GetScriptedGui('ve_has_active_cultural_project_gui').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				hbox = {
					using = main_bg
					layoutpolicy_horizontal = expanding
					hbox = {
						layoutpolicy_horizontal = expanding
						margin = { 20 12 }
						spacing = 20

						vbox = {
							layoutpolicy_horizontal = expanding
							spacing = 2
							tooltip = "[GetPlayer.GetCustom('ve_cultural_project_description')]"
							using = tooltip_below
							textbox = {
								text = "ve_cultural_project_active_label"
								default_format = "#instruction"
								using = fontsize_small
								align = nobaseline
								autoresize = yes
							}
							textbox = {
								raw_text = "[GetPlayer.GetCustom('ve_cultural_project_name')]"
								default_format = "#tooltip_header"
								using = fontsize_xl
								align = nobaseline
								autoresize = yes
							}
							textbox = {
								raw_text = "[GetPlayer.GetCustom('ve_cultural_project_target')]"
								using = fontsize_small
								align = nobaseline
								maximumsize = { 400 -1 }
								elide = right
								autoresize = yes
							}
						}

						vertical_divider = {
							blockoverride "size" {
								size = { 16 100% }
							}
						}

						vbox = {
							layoutpolicy_horizontal = expanding
							spacing = 2
							tooltip = "ve_cultural_project_progress_tt"
							using = tooltip_below
							textbox = {
								text = "ve_cultural_project_progress"
								default_format = "#tooltippable_name"
								using = fontsize_small
								align = nobaseline
								autoresize = yes
							}
							hbox = {
								spacing = 6
								textbox = {
									raw_text = "[GetPlayer.MakeScope.Var('ve_cultural_project_progress').GetValue|0] / 100"
									default_format = "#instruction"
									using = fontsize_xl
									align = nobaseline
									autoresize = yes
								}
								textbox = {
									raw_text = "([GetPlayer.MakeScope.ScriptValue('ve_monthly_cultural_project_progress')|+=0])"
									using = fontsize_small
									align = vcenter|nobaseline
									autoresize = yes
								}
							}
							white_progressbar_horizontal = {
								size = { 320 10 }
								blockoverride "values" {
									max = 100
									value = "[GetPlayer.MakeScope.Var('ve_cultural_project_progress').GetValue]"
								}
							}
						}

						vertical_divider = {
							blockoverride "size" {
								size = { 16 100% }
							}
						}

						vbox = { # centred against the taller text column
							layoutpolicy_vertical = expanding
							expand = {}
							hbox = { # cancel, then confirm / keep in the same footprint
								spacing = 6
								button = {
									using = default_button_action
									size = { 200 28 }
									text = "ve_cancel_cultural_project_button"
									onclick = "[GetVariableSystem.Set('confirm_cancel_cultural_project', 'yes')]"
									enabled = "[GetScriptedGui('ve_cancel_cultural_project_gui').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
									visible = "[Not(GetVariableSystem.Exists('confirm_cancel_cultural_project'))]"
									tooltip = "ve_cancel_cultural_project_tt"
									using = tooltip_below
								}
								button = {
									using = default_button_action
									size = { 200 28 }
									text = "ve_confirm_cancel_button"
									onclick = "[GetVariableSystem.Clear('confirm_cancel_cultural_project')]"
									onclick = "[GetScriptedGui('ve_cancel_cultural_project_gui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
									visible = "[GetVariableSystem.Exists('confirm_cancel_cultural_project')]"
									tooltip = "ve_cancel_cultural_project_tt"
									using = tooltip_below
								}
								button = {
									using = default_button_action
									size = { 140 28 }
									text = "ve_keep_project_button"
									onclick = "[GetVariableSystem.Clear('confirm_cancel_cultural_project')]"
									visible = "[GetVariableSystem.Exists('confirm_cancel_cultural_project')]"
								}
							}
							expand = {}
						}
					}
				}
			}

			hbox = { # No project running: the three choices, side by side
				layoutpolicy_horizontal = expanding
				margin = { 0 15 }
				spacing = 10
				visible = "[GetScriptedGui('ve_has_no_active_cultural_project_gui').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"

				vbox = { # National Curriculum
					using = main_bg
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					minimumsize = { 0 132 }
					hbox = {
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding
						margin = { 12 8 }
						spacing = 8
						tooltip = "ve_national_curriculum_desc"
						using = tooltip_below
						vbox = { # centred, and still contributes its size to the row
							layoutpolicy_vertical = expanding
							expand = {}
							icon = {
								texture = "gfx/interface/icons/institution_icons/schools.dds"
								size = { 44 44 }
							}
							expand = {}
						}
						vbox = {
							layoutpolicy_horizontal = expanding
							spacing = 2
							textbox = {
								text = "ve_national_curriculum_name"
								default_format = "#tooltip_header"
								using = fontsize_large
								align = nobaseline
								autoresize = yes
							}
							textbox = {
								text = "ve_national_curriculum_cost"
								using = fontsize_small
								align = nobaseline
								autoresize = yes
							}
							textbox = {
								text = "ve_national_curriculum_short"
								using = fontsize_small
								align = nobaseline
								maximumsize = { 330 36 }
								multiline = yes
								autoresize = yes
							}
						}
						button = {
							using = default_button_action
							size = { 200 26 }
							text = "ve_begin_project_button"
							onclick = "[GetScriptedGui('ve_begin_national_curriculum_gui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
							enabled = "[GetScriptedGui('ve_begin_national_curriculum_gui').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
							tooltip = "[GetScriptedGui('ve_begin_national_curriculum_gui').BuildTooltip(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
							using = tooltip_below
						}
					}
				}

				vbox = { # Shared Symbols
					using = main_bg
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					minimumsize = { 0 132 }
					hbox = {
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding
						margin = { 12 8 }
						spacing = 8
						tooltip = "ve_shared_symbols_desc"
						using = tooltip_below
						vbox = { # centred, and still contributes its size to the row
							layoutpolicy_vertical = expanding
							expand = {}
							icon = {
								texture = "gfx/interface/icons/decree/decree_promote_national_values.dds"
								size = { 44 44 }
							}
							expand = {}
						}
						vbox = {
							layoutpolicy_horizontal = expanding
							spacing = 2
							textbox = {
								text = "ve_shared_symbols_name"
								default_format = "#tooltip_header"
								using = fontsize_large
								align = nobaseline
								autoresize = yes
							}
							textbox = {
								text = "ve_shared_symbols_cost"
								using = fontsize_small
								align = nobaseline
								autoresize = yes
							}
							textbox = {
								text = "ve_shared_symbols_short"
								using = fontsize_small
								align = nobaseline
								maximumsize = { 330 36 }
								multiline = yes
								autoresize = yes
							}
						}
						button = {
							using = default_button_action
							size = { 200 26 }
							text = "ve_begin_project_button"
							onclick = "[GetScriptedGui('ve_begin_shared_symbols_gui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
							enabled = "[GetScriptedGui('ve_begin_shared_symbols_gui').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
							tooltip = "[GetScriptedGui('ve_begin_shared_symbols_gui').BuildTooltip(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
							using = tooltip_below
						}
					}
				}

				vbox = { # The identity model's project, started from a State
					using = main_bg
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					minimumsize = { 0 132 }
					hbox = {
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding
						margin = { 12 8 }
						spacing = 8
						tooltip = "[GetPlayer.GetCustom('ve_model_project_description')]"
						using = tooltip_below
						vbox = { # one wrapper for all three variants: the hidden ones take no
							# height, so the row pays its spacing once, not three times
							layoutpolicy_vertical = expanding
							expand = {}
							icon = {
								texture = "gfx/interface/icons/generic_icons/assimilation.dds"
								size = { 44 44 }
								visible = "[EqualTo_CFixedPoint(GetPlayer.MakeScope.Var('ve_identity_model').GetValue, '(CFixedPoint)1')]"
							}
							icon = {
								texture = "gfx/interface/icons/law_icons/freedom_of_conscience.dds"
								size = { 44 44 }
								visible = "[EqualTo_CFixedPoint(GetPlayer.MakeScope.Var('ve_identity_model').GetValue, '(CFixedPoint)2')]"
							}
							icon = {
								texture = "gfx/interface/icons/map_mode_icons/cultures.dds"
								size = { 44 44 }
								visible = "[EqualTo_CFixedPoint(GetPlayer.MakeScope.Var('ve_identity_model').GetValue, '(CFixedPoint)3')]"
							}
							expand = {}
						}
						vbox = {
							layoutpolicy_horizontal = expanding
							spacing = 2
							textbox = {
								raw_text = "[GetPlayer.GetCustom('ve_model_project_name')]"
								default_format = "#tooltip_header"
								using = fontsize_large
								align = nobaseline
								autoresize = yes
							}
							textbox = {
								raw_text = "[GetPlayer.GetCustom('ve_model_project_cost')]"
								using = fontsize_small
								align = nobaseline
								autoresize = yes
							}
							textbox = {
								raw_text = "[GetPlayer.GetCustom('ve_model_project_short')]"
								using = fontsize_small
								align = nobaseline
								maximumsize = { 330 36 }
								multiline = yes
								autoresize = yes
							}
						}
						textbox = {
							text = "ve_targeted_project_start_instruction_short"
							default_format = "#instruction"
							using = fontsize_small
							align = nobaseline
							maximumsize = { 330 36 }
							multiline = yes
							autoresize = yes
						}
					}
				}
			}

			expand = {}
		}
	}
}
