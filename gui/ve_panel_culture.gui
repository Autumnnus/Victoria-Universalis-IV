					using = tooltip_below
				}
				textbox = { # only while a transition backlash blocks another switch
					text = "ve_identity_transition_backlash_notice_short"
					default_format = "#N"
					tooltip = "ve_identity_transition_backlash_notice"
					using = tooltip_below
					using = fontsize_small
					align = vcenter|nobaseline
					autoresize = yes
					visible = "[GetScriptedGui('ve_identity_transition_backlash_gui').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				}
				expand = {}
			}

			hbox = { # Three identity models side by side
				layoutpolicy_horizontal = expanding
				margin = { 0 15 }
				spacing = 10

				vbox = { # Ethnic Nation
					using = main_bg
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					minimumsize = { 0 146 }
					hbox = {
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding
						margin = { 12 8 }
						spacing = 8
						tooltip = "ve_ethnic_identity_desc"
						using = tooltip_below
						vbox = { # centred, and still contributes its size to the row
							layoutpolicy_vertical = expanding
							expand = {}
							icon = {
								texture = "gfx/interface/icons/ideology_icons/ethno_nationalist.dds"
								size = { 44 44 }
							}
							expand = {}
						}
						vbox = {
							layoutpolicy_horizontal = expanding
							layoutpolicy_vertical = expanding
							spacing = 2
							hbox = {
								spacing = 4
								icon = {
									texture = "gfx/interface/icons/generic_icons/green_checkmark.dds"
									size = { 16 16 }
									visible = "[EqualTo_CFixedPoint(GetPlayer.MakeScope.Var('ve_identity_model').GetValue, '(CFixedPoint)1')]"
								}
								textbox = {
									text = "ve_ethnic_identity_name"
									default_format = "#tooltip_header"
									using = fontsize_large
									align = nobaseline
									autoresize = yes
								}
								expand = {}
							}
							textbox = {
								text = "ve_ethnic_identity_short"
								using = fontsize_small
								align = nobaseline
								maximumsize = { 330 36 }
								multiline = yes
								autoresize = yes
							}
							textbox = {
								text = "ve_ethnic_identity_unlocks"
								default_format = "#instruction"
								using = fontsize_small
								align = nobaseline
								maximumsize = { 330 -1 }
								elide = right
								autoresize = yes
							}
							expand = {}
							textbox = {
								text = "ve_switch_identity_cost_label"
								default_format = "#instruction"
								using = fontsize_small
								align = nobaseline
								autoresize = yes
								visible = "[Not(EqualTo_CFixedPoint(GetPlayer.MakeScope.Var('ve_identity_model').GetValue, '(CFixedPoint)1'))]"
							}
							button = {
								using = default_button_action
								layoutpolicy_horizontal = expanding
								size = { 0 28 }
								text = "ve_switch_identity_button"
								onclick = "[GetScriptedGui('ve_choose_ethnic_identity').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								enabled = "[GetScriptedGui('ve_choose_ethnic_identity').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								tooltip = "[GetScriptedGui('ve_choose_ethnic_identity').BuildTooltip(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								using = tooltip_below
								visible = "[Not(EqualTo_CFixedPoint(GetPlayer.MakeScope.Var('ve_identity_model').GetValue, '(CFixedPoint)1'))]"
							}
							textbox = {
								text = "ve_identity_model_active_footer"
								default_format = "#P"
								using = fontsize_small
								align = center|nobaseline
								layoutpolicy_horizontal = expanding
								minimumsize = { 0 28 }
								visible = "[EqualTo_CFixedPoint(GetPlayer.MakeScope.Var('ve_identity_model').GetValue, '(CFixedPoint)1')]"
							}
						}
					}
				}

				vbox = { # Civic Nation
					using = main_bg
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					minimumsize = { 0 146 }
					hbox = {
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding
						margin = { 12 8 }
						spacing = 8
						tooltip = "ve_civic_identity_desc"
						using = tooltip_below
						vbox = { # centred, and still contributes its size to the row
							layoutpolicy_vertical = expanding
							expand = {}
							icon = {
								texture = "gfx/interface/icons/ideology_icons/egalitarian.dds"
								size = { 44 44 }
							}
							expand = {}
						}
						vbox = {
							layoutpolicy_horizontal = expanding
							layoutpolicy_vertical = expanding
							spacing = 2
							hbox = {
								spacing = 4
								icon = {
									texture = "gfx/interface/icons/generic_icons/green_checkmark.dds"
									size = { 16 16 }
									visible = "[EqualTo_CFixedPoint(GetPlayer.MakeScope.Var('ve_identity_model').GetValue, '(CFixedPoint)2')]"
								}
								textbox = {
									text = "ve_civic_identity_name"
									default_format = "#tooltip_header"
									using = fontsize_large
									align = nobaseline
									autoresize = yes
								}
								expand = {}
							}
							textbox = {
								text = "ve_civic_identity_short"
								using = fontsize_small
								align = nobaseline
								maximumsize = { 330 36 }
								multiline = yes
								autoresize = yes
							}
							textbox = {
								text = "ve_civic_identity_unlocks"
								default_format = "#instruction"
								using = fontsize_small
								align = nobaseline
								maximumsize = { 330 -1 }
								elide = right
								autoresize = yes
							}
							expand = {}
							textbox = {
								text = "ve_switch_identity_cost_label"
								default_format = "#instruction"
								using = fontsize_small
								align = nobaseline
								autoresize = yes
								visible = "[Not(EqualTo_CFixedPoint(GetPlayer.MakeScope.Var('ve_identity_model').GetValue, '(CFixedPoint)2'))]"
							}
							button = {
								using = default_button_action
								layoutpolicy_horizontal = expanding
								size = { 0 28 }
								text = "ve_switch_identity_button"
								onclick = "[GetScriptedGui('ve_choose_civic_identity').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								enabled = "[GetScriptedGui('ve_choose_civic_identity').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								tooltip = "[GetScriptedGui('ve_choose_civic_identity').BuildTooltip(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								using = tooltip_below
								visible = "[Not(EqualTo_CFixedPoint(GetPlayer.MakeScope.Var('ve_identity_model').GetValue, '(CFixedPoint)2'))]"
							}
							textbox = {
								text = "ve_identity_model_active_footer"
								default_format = "#P"
								using = fontsize_small
								align = center|nobaseline
								layoutpolicy_horizontal = expanding
								minimumsize = { 0 28 }
								visible = "[EqualTo_CFixedPoint(GetPlayer.MakeScope.Var('ve_identity_model').GetValue, '(CFixedPoint)2')]"
							}
						}
					}
				}

				vbox = { # Composite State
					using = main_bg
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					minimumsize = { 0 146 }
					hbox = {
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding
						margin = { 12 8 }
						spacing = 8
						tooltip = "ve_composite_identity_desc"
						using = tooltip_below
						vbox = { # centred, and still contributes its size to the row
							layoutpolicy_vertical = expanding
							expand = {}
							icon = {
								texture = "gfx/interface/icons/ideology_icons/particularist.dds"
								size = { 44 44 }
							}
							expand = {}
						}
						vbox = {
							layoutpolicy_horizontal = expanding
							layoutpolicy_vertical = expanding
							spacing = 2
							hbox = {
								spacing = 4
								icon = {
									texture = "gfx/interface/icons/generic_icons/green_checkmark.dds"
									size = { 16 16 }
									visible = "[EqualTo_CFixedPoint(GetPlayer.MakeScope.Var('ve_identity_model').GetValue, '(CFixedPoint)3')]"
								}
								textbox = {
									text = "ve_composite_identity_name"
									default_format = "#tooltip_header"
									using = fontsize_large
									align = nobaseline
									autoresize = yes
								}
								expand = {}
							}
							textbox = {
								text = "ve_composite_identity_short"
								using = fontsize_small
								align = nobaseline
								maximumsize = { 330 36 }
								multiline = yes
								autoresize = yes
							}
							textbox = {
								text = "ve_composite_identity_unlocks"
								default_format = "#instruction"
								using = fontsize_small
								align = nobaseline
								maximumsize = { 330 -1 }
								elide = right
								autoresize = yes
							}
							expand = {}
							textbox = {
								text = "ve_switch_identity_cost_label"
								default_format = "#instruction"
								using = fontsize_small
								align = nobaseline
								autoresize = yes
								visible = "[Not(EqualTo_CFixedPoint(GetPlayer.MakeScope.Var('ve_identity_model').GetValue, '(CFixedPoint)3'))]"
							}
							button = {
								using = default_button_action
								layoutpolicy_horizontal = expanding
								size = { 0 28 }
								text = "ve_switch_identity_button"
								onclick = "[GetScriptedGui('ve_choose_composite_identity').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								enabled = "[GetScriptedGui('ve_choose_composite_identity').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								tooltip = "[GetScriptedGui('ve_choose_composite_identity').BuildTooltip(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								using = tooltip_below
								visible = "[Not(EqualTo_CFixedPoint(GetPlayer.MakeScope.Var('ve_identity_model').GetValue, '(CFixedPoint)3'))]"
							}
							textbox = {
								text = "ve_identity_model_active_footer"
								default_format = "#P"
								using = fontsize_small
								align = center|nobaseline
								layoutpolicy_horizontal = expanding
								minimumsize = { 0 28 }
								visible = "[EqualTo_CFixedPoint(GetPlayer.MakeScope.Var('ve_identity_model').GetValue, '(CFixedPoint)3')]"
							}
						}
					}
				}
			}

			hbox = { # Section label: Cultural Projects
				layoutpolicy_horizontal = expanding
				margin = { 2 15 }
				spacing = 6
				textbox = {
					text = "ve_cultural_projects"
					default_format = "#tooltip_header"
					using = fontsize_large
					align = nobaseline
					autoresize = yes
				}
				icon = {
					texture = "gfx/interface/icons/generic_icons/information.dds"
					size = { 20 20 }
					tooltip = "ve_cultural_projects_intro"
					using = tooltip_below
				}
				textbox = { # only while a cancellation backlash blocks a new project
					text = "ve_cultural_project_backlash_notice_short"
					default_format = "#N"
					tooltip = "ve_cultural_project_backlash_notice"
					using = tooltip_below
					using = fontsize_small
					align = vcenter|nobaseline
					autoresize = yes
					visible = "[GetScriptedGui('ve_cultural_project_backlash_gui').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
