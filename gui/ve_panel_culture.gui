types ve_gui_panel_types
{
	type ve_panel_culture = vbox {
		layoutpolicy_horizontal = expanding
		layoutpolicy_vertical = expanding

		vbox = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
			spacing = 15

			hbox = { # National identity overview
				layoutpolicy_horizontal = expanding
				margin = { 0 20 }

				hbox = {
					using = main_bg
					layoutpolicy_horizontal = preferred
					vbox = {
						spacing = 10
						margin = { 30 10 }
						icon = {
							texture = "gfx/interface/population/pop_culture.dds"
							size = { 120 120 }
						}
						textbox = {
							text = "#v [GetPlayer.GetPrimaryCulturesDesc]#!"
							using = fontsize_xxl
							align = center
							elide = left
							minimumsize = { 100 -1 }
							maximumsize = { 420 -1 }
							multiline = yes
							autoresize = yes
						}
					}
				}

				hbox = {
					using = main_bg
					layoutpolicy_horizontal = expanding
					hbox = {
						layoutpolicy_horizontal = expanding
						margin = { 20 20 }
						spacing = 35

						vbox = {
							spacing = 10
							tooltip = "[GetScriptedGui('ve_identity_model_tooltip').BuildTooltip(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
							using = tooltip_below
							textbox = {
								text = "ve_current_identity_model"
								default_format = "#tooltippable_name"
								using = fontsize_xxl
								align = nobaseline
								autoresize = yes
							}
							textbox = {
								raw_text = "[GetPlayer.GetCustom('ve_identity_model_name')]"
								default_format = "#instruction"
								using = fontsize_xxl
								align = nobaseline
								autoresize = yes
							}
						}

						vbox = {
							spacing = 10
							tooltip = "ve_culture_reform_point_tt"
							textbox = {
								text = "ve_cultural_mandate"
								default_format = "#tooltippable_name"
								using = fontsize_xxl
								align = nobaseline
								autoresize = yes
							}
							textbox = {
								text = "[GetPlayer.MakeScope.Var('culture_reform_point').GetValue|0] / 500"
								default_format = "#instruction"
								using = fontsize_xxl
								align = nobaseline
								autoresize = yes
							}
							white_progressbar_horizontal = {
								size = { 130 15 }
								tooltip = "ve_culture_reform_point_tt"
								blockoverride "values" {
									max = 500
									value = "[GetPlayer.MakeScope.Var('culture_reform_point').GetValue]"
								}
							}
						}

						vbox = {
							spacing = 10
							tooltip = "ve_national_cohesion_tt"
							textbox = {
								text = "ve_national_cohesion"
								default_format = "#tooltippable_name"
								using = fontsize_xxl
								align = nobaseline
								autoresize = yes
							}
							hbox = {
								spacing = 8
								textbox = {
									text = "[GetPlayer.MakeScope.Var('ve_national_cohesion').GetValue|0] / 100"
									default_format = "#instruction"
									using = fontsize_xxl
									align = nobaseline
									autoresize = yes
								}
								textbox = {
									text = "([GetPlayer.MakeScope.ScriptValue('ve_monthly_national_cohesion')|+=0])"
									using = fontsize_xl
									align = nobaseline
									autoresize = yes
								}
							}
							white_progressbar_horizontal = {
								size = { 130 15 }
								tooltip = "ve_national_cohesion_tt"
								blockoverride "values" {
									max = 100
									value = "[GetPlayer.MakeScope.Var('ve_national_cohesion').GetValue]"
								}
							}
						}
					}
				}
			}

			vbox = { # Identity model selection
				layoutpolicy_horizontal = expanding
				spacing = 15
				header_pattern = {
					layoutpolicy_horizontal = expanding
					blockoverride "header_text" {
						text = "ve_identity_models"
						default_format = "#tooltip_header"
					}
					blockoverride "button_close" {
						visible = no
					}
				}

				hbox = {
					using = main_bg
					layoutpolicy_horizontal = expanding
					margin = { 20 20 }
					spacing = 20

					vbox = {
						layoutpolicy_horizontal = expanding
						spacing = 15
						textbox = {
							text = "ve_ethnic_identity_name"
							default_format = "#tooltip_header"
							using = fontsize_xxl
							align = center|nobaseline
							autoresize = yes
						}
						textbox = {
							text = "ve_ethnic_identity_desc"
							using = fontsize_xl
							align = center|nobaseline
							maximumsize = { 360 -1 }
							multiline = yes
							autoresize = yes
						}
						button = {
							using = default_button_action
							size = { 300 45 }
							text = "ve_adopt_ethnic_identity"
							onclick = "[GetScriptedGui('ve_choose_ethnic_identity').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
							enabled = "[GetScriptedGui('ve_choose_ethnic_identity').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
							tooltip = "[GetScriptedGui('ve_choose_ethnic_identity').BuildTooltip(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
							using = tooltip_below
						}
					}

					vbox = {
						layoutpolicy_horizontal = expanding
						spacing = 15
						textbox = {
							text = "ve_civic_identity_name"
							default_format = "#tooltip_header"
							using = fontsize_xxl
							align = center|nobaseline
							autoresize = yes
						}
						textbox = {
							text = "ve_civic_identity_desc"
							using = fontsize_xl
							align = center|nobaseline
							maximumsize = { 360 -1 }
							multiline = yes
							autoresize = yes
						}
						button = {
							using = default_button_action
							size = { 300 45 }
							text = "ve_adopt_civic_identity"
							onclick = "[GetScriptedGui('ve_choose_civic_identity').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
							enabled = "[GetScriptedGui('ve_choose_civic_identity').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
							tooltip = "[GetScriptedGui('ve_choose_civic_identity').BuildTooltip(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
							using = tooltip_below
						}
					}

					vbox = {
						layoutpolicy_horizontal = expanding
						spacing = 15
						textbox = {
							text = "ve_composite_identity_name"
							default_format = "#tooltip_header"
							using = fontsize_xxl
							align = center|nobaseline
							autoresize = yes
						}
						textbox = {
							text = "ve_composite_identity_desc"
							using = fontsize_xl
							align = center|nobaseline
							maximumsize = { 360 -1 }
							multiline = yes
							autoresize = yes
						}
						button = {
							using = default_button_action
							size = { 300 45 }
							text = "ve_adopt_composite_identity"
							onclick = "[GetScriptedGui('ve_choose_composite_identity').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
							enabled = "[GetScriptedGui('ve_choose_composite_identity').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
							tooltip = "[GetScriptedGui('ve_choose_composite_identity').BuildTooltip(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
							using = tooltip_below
						}
					}
				}
			}

			vbox = { # Cultural projects
				layoutpolicy_horizontal = expanding
				spacing = 15
				header_pattern = {
					layoutpolicy_horizontal = expanding
					blockoverride "header_text" {
						text = "ve_cultural_projects"
						default_format = "#tooltip_header"
					}
					blockoverride "button_close" {
						visible = no
					}
				}
				hbox = {
					using = main_bg
					layoutpolicy_horizontal = expanding
					margin = { 20 20 }
					spacing = 30
					visible = "[GetScriptedGui('ve_has_active_cultural_project_gui').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"

					vbox = {
						layoutpolicy_horizontal = expanding
						spacing = 10
						textbox = {
							raw_text = "[GetPlayer.GetCustom('ve_cultural_project_name')]"
							default_format = "#tooltip_header"
							using = fontsize_xxl
							autoresize = yes
						}
						textbox = {
							raw_text = "[GetPlayer.GetCustom('ve_cultural_project_target')]"
							default_format = "#instruction"
							using = fontsize_xl
							multiline = yes
							autoresize = yes
						}
						textbox = {
							raw_text = "[GetPlayer.GetCustom('ve_cultural_project_description')]"
							using = fontsize_l
							maximumsize = { 520 -1 }
							multiline = yes
							autoresize = yes
						}
					}

					vbox = {
						layoutpolicy_horizontal = expanding
						spacing = 10
						tooltip = "ve_cultural_project_progress_tt"
						using = tooltip_below
						textbox = {
							text = "ve_cultural_project_progress"
							default_format = "#tooltippable_name"
							using = fontsize_xl
							autoresize = yes
						}
						hbox = {
							spacing = 10
							textbox = {
								text = "[GetPlayer.MakeScope.Var('ve_cultural_project_progress').GetValue|0] / 100"
								default_format = "#instruction"
								using = fontsize_xxl
								autoresize = yes
							}
							textbox = {
								text = "([GetPlayer.MakeScope.ScriptValue('ve_monthly_cultural_project_progress')|+=0])"
								using = fontsize_xl
								autoresize = yes
							}
						}
						white_progressbar_horizontal = {
							size = { 260 15 }
							tooltip = "ve_cultural_project_progress_tt"
							blockoverride "values" {
								max = 100
								value = "[GetPlayer.MakeScope.Var('ve_cultural_project_progress').GetValue]"
							}
						}
					}

					button = {
						using = default_button_action
						size = { 260 45 }
						text = "ve_cancel_cultural_project_button"
						onclick = "[GetScriptedGui('ve_cancel_cultural_project_gui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						enabled = "[GetScriptedGui('ve_cancel_cultural_project_gui').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						tooltip = "ve_cancel_cultural_project_tt"
						using = tooltip_below
					}
				}

				vbox = {
					using = main_bg
					layoutpolicy_horizontal = expanding
					margin = { 20 20 }
					spacing = 20
					visible = "[GetScriptedGui('ve_has_no_active_cultural_project_gui').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"

					textbox = {
						text = "ve_cultural_projects_intro"
						using = fontsize_xl
						align = center|nobaseline
						multiline = yes
						autoresize = yes
					}

					hbox = {
						layoutpolicy_horizontal = expanding
						spacing = 20

						vbox = {
							layoutpolicy_horizontal = expanding
							spacing = 10
							textbox = {
								text = "ve_national_curriculum_name"
								default_format = "#tooltip_header"
								using = fontsize_xxl
								align = center|nobaseline
								autoresize = yes
							}
							textbox = {
								text = "ve_national_curriculum_desc"
								using = fontsize_xl
								align = center|nobaseline
								maximumsize = { 390 -1 }
								multiline = yes
								autoresize = yes
							}
							button = {
								using = default_button_action
								size = { 300 45 }
								text = "ve_begin_national_curriculum"
								onclick = "[GetScriptedGui('ve_begin_national_curriculum_gui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								enabled = "[GetScriptedGui('ve_begin_national_curriculum_gui').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								tooltip = "[GetScriptedGui('ve_begin_national_curriculum_gui').BuildTooltip(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								using = tooltip_below
							}
						}

						vbox = {
							layoutpolicy_horizontal = expanding
							spacing = 10
							textbox = {
								text = "ve_shared_symbols_name"
								default_format = "#tooltip_header"
								using = fontsize_xxl
								align = center|nobaseline
								autoresize = yes
							}
							textbox = {
								text = "ve_shared_symbols_desc"
								using = fontsize_xl
								align = center|nobaseline
								maximumsize = { 390 -1 }
								multiline = yes
								autoresize = yes
							}
							button = {
								using = default_button_action
								size = { 300 45 }
								text = "ve_begin_shared_symbols"
								onclick = "[GetScriptedGui('ve_begin_shared_symbols_gui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								enabled = "[GetScriptedGui('ve_begin_shared_symbols_gui').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								tooltip = "[GetScriptedGui('ve_begin_shared_symbols_gui').BuildTooltip(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								using = tooltip_below
							}
						}

						vbox = {
							layoutpolicy_horizontal = expanding
							spacing = 10
							textbox = {
								raw_text = "[GetPlayer.GetCustom('ve_model_project_name')]"
								default_format = "#tooltip_header"
								using = fontsize_xxl
								align = center|nobaseline
								autoresize = yes
							}
							textbox = {
								raw_text = "[GetPlayer.GetCustom('ve_model_project_description')]"
								using = fontsize_xl
								align = center|nobaseline
								maximumsize = { 390 -1 }
								multiline = yes
								autoresize = yes
							}
							textbox = {
								text = "ve_targeted_project_start_instruction"
								default_format = "#instruction"
								using = fontsize_xl
								align = center|nobaseline
								maximumsize = { 390 -1 }
								multiline = yes
								autoresize = yes
							}
						}
					}
				}
			}
		}
	}
}
