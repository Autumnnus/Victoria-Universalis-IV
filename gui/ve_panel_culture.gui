types ve_gui_panel_types
{
	# National Identity page. One screen: no tabs, no scrolling. Sections are packed
	# horizontally instead of stacked, so the page fits the fullscreen content area
	# down to 1366x768 (~630 px usable; this page needs ~470).
	#
	# Layout contract, shared with gui/ve_panel_religion.gui - keep both in step:
	#   1. A card shows an icon, a name and at most one short line. Every full
	#      modifier list lives in that card's tooltip (*_desc / *_tt localization).
	#   2. Current state is stated twice: in the summary strip, and on the card as a
	#      checkmark plus a footer that replaces the action button.
	#   3. A section is one label line with an information icon whose tooltip is that
	#      section's help paragraph. Nothing explanatory is printed on the page; only
	#      conditional red notices (backlash), and only while they are live.
	#   4. Nothing may grow vertically with its content: long text is elided or
	#      capped with maximumsize, because one tall card brings back the scrollbar.

	# One meter in the summary strip: label, value / max, signed monthly delta, bar,
	# and an optional status line.
	type ve_culture_meter = vbox {
		spacing = 2
		block "meter_tooltip" {}
		using = tooltip_below

		block "meter_label" {}
		hbox = {
			spacing = 6
			block "meter_value" {}
		}
		block "meter_bar" {}
		block "meter_extra" {}
	}

	type ve_panel_culture = vbox {
		layoutpolicy_horizontal = expanding
		layoutpolicy_vertical = expanding

		vbox = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
			spacing = 8

			hbox = { # Summary strip: primary cultures, active model, three meters
				layoutpolicy_horizontal = expanding
				margin = { 0 12 }
				spacing = 10

				hbox = {
					using = main_bg
					layoutpolicy_horizontal = preferred
					hbox = {
						margin = { 14 8 }
						spacing = 10
						vbox = { # centred, and still contributes its size to the row
							layoutpolicy_vertical = expanding
							expand = {}
							icon = {
								texture = "gfx/interface/population/pop_culture.dds"
								size = { 52 52 }
							}
							expand = {}
						}
						vbox = {
							spacing = 2
							textbox = {
								text = "ve_primary_cultures_label"
								default_format = "#instruction"
								using = fontsize_small
								align = nobaseline
								autoresize = yes
							}
							textbox = {
								raw_text = "#v [GetPlayer.GetPrimaryCulturesDesc]#!"
								using = fontsize_xl
								align = nobaseline
								maximumsize = { 260 -1 }
								elide = right
								autoresize = yes
							}
							hbox = {
								spacing = 6
								tooltip = "[GetScriptedGui('ve_identity_model_tooltip').BuildTooltip(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								using = tooltip_below
								icon = {
									size = { 20 20 }
									texture = "gfx/interface/icons/ideology_icons/ethno_nationalist.dds"
									visible = "[EqualTo_CFixedPoint(GetPlayer.MakeScope.Var('ve_identity_model').GetValue, '(CFixedPoint)1')]"
								}
								icon = {
									size = { 20 20 }
									texture = "gfx/interface/icons/ideology_icons/egalitarian.dds"
									visible = "[EqualTo_CFixedPoint(GetPlayer.MakeScope.Var('ve_identity_model').GetValue, '(CFixedPoint)2')]"
								}
								icon = {
									size = { 20 20 }
									texture = "gfx/interface/icons/ideology_icons/particularist.dds"
									visible = "[EqualTo_CFixedPoint(GetPlayer.MakeScope.Var('ve_identity_model').GetValue, '(CFixedPoint)3')]"
								}
								textbox = {
									raw_text = "#P [GetPlayer.GetCustom('ve_identity_model_name')]#!"
									using = fontsize_large
									align = vcenter|nobaseline
									maximumsize = { 230 -1 }
									elide = right
									autoresize = yes
								}
							}
						}
					}
				}

				hbox = {
					using = main_bg
					layoutpolicy_horizontal = expanding
					hbox = {
						layoutpolicy_horizontal = expanding
						margin = { 16 8 }
						spacing = 24

						ve_culture_meter = { # Cultural Mandate
							blockoverride "meter_tooltip" { tooltip = "ve_culture_reform_point_tt" }
							blockoverride "meter_label" {
								hbox = {
									spacing = 4
									icon = {
										texture = "gfx/interface/icons/generic_icons/mandate.dds"
										size = { 20 20 }
									}
									textbox = {
										text = "ve_cultural_mandate"
										default_format = "#tooltippable_name"
										using = fontsize_large
										align = vcenter|nobaseline
										autoresize = yes
									}
								}
							}
							blockoverride "meter_value" {
								textbox = {
									raw_text = "[GetPlayer.MakeScope.Var('culture_reform_point').GetValue|0] / 500"
									default_format = "#instruction"
									using = fontsize_xl
									align = nobaseline
									autoresize = yes
								}
								textbox = {
									raw_text = "([GetPlayer.MakeScope.ScriptValue('ve_monthly_national_identity')|+=0])"
									using = fontsize_small
									align = vcenter|nobaseline
									autoresize = yes
								}
							}
							blockoverride "meter_bar" {
								white_progressbar_horizontal = {
									size = { 150 8 }
									blockoverride "values" {
										max = 500
										value = "[GetPlayer.MakeScope.Var('culture_reform_point').GetValue]"
									}
								}
							}
							blockoverride "meter_extra" {
								textbox = { # only while a transition backlash blocks another switch
									text = "ve_identity_transition_backlash_notice_short"
									default_format = "#N"
									using = fontsize_small
									align = nobaseline
									maximumsize = { 240 -1 }
									elide = right
									autoresize = yes
									visible = "[GetScriptedGui('ve_identity_transition_backlash_gui').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								}
							}
						}

						ve_culture_meter = { # National Cohesion
							blockoverride "meter_tooltip" { tooltip = "ve_national_cohesion_tt" }
							blockoverride "meter_label" {
								hbox = {
									spacing = 4
									icon = {
										texture = "gfx/interface/icons/generic_icons/cohesion.dds"
										size = { 20 20 }
									}
									textbox = {
										text = "ve_national_cohesion"
										default_format = "#tooltippable_name"
										using = fontsize_large
										align = vcenter|nobaseline
										autoresize = yes
									}
								}
							}
							blockoverride "meter_value" {
								textbox = {
									raw_text = "[GetPlayer.MakeScope.Var('ve_national_cohesion').GetValue|0] / 100"
									default_format = "#instruction"
									using = fontsize_xl
									align = nobaseline
									autoresize = yes
								}
								textbox = {
									raw_text = "([GetPlayer.MakeScope.ScriptValue('ve_monthly_national_cohesion')|+=0])"
									using = fontsize_small
									align = vcenter|nobaseline
									autoresize = yes
								}
							}
							blockoverride "meter_bar" {
								white_progressbar_horizontal = {
									size = { 150 8 }
									blockoverride "values" {
										max = 100
										value = "[GetPlayer.MakeScope.Var('ve_national_cohesion').GetValue]"
									}
								}
							}
							blockoverride "meter_extra" { # tier badge; the middle band shows nothing
								textbox = {
									text = "ve_cohesion_tier_high"
									default_format = "#P"
									using = fontsize_small
									align = nobaseline
									maximumsize = { 240 -1 }
									elide = right
									autoresize = yes
									visible = "[GreaterThanOrEqualTo_CFixedPoint(GetPlayer.MakeScope.Var('ve_national_cohesion').GetValue, '(CFixedPoint)75')]"
								}
								textbox = {
									text = "ve_cohesion_tier_low"
									default_format = "#N"
									using = fontsize_small
									align = nobaseline
									maximumsize = { 240 -1 }
									elide = right
									autoresize = yes
									visible = "[LessThanOrEqualTo_CFixedPoint(GetPlayer.MakeScope.Var('ve_national_cohesion').GetValue, '(CFixedPoint)25')]"
								}
							}
						}

						ve_culture_meter = { # Cultural Project
							blockoverride "meter_tooltip" { tooltip = "ve_cultural_project_progress_tt" }
							blockoverride "meter_label" {
								hbox = {
									spacing = 4
									icon = {
										texture = "gfx/interface/icons/generic_icons/cultural_fervor.dds"
										size = { 20 20 }
									}
									textbox = {
										text = "ve_cultural_project_progress"
										default_format = "#tooltippable_name"
										using = fontsize_large
										align = vcenter|nobaseline
										autoresize = yes
									}
								}
							}
							blockoverride "meter_value" {
								textbox = {
									raw_text = "[GetPlayer.MakeScope.Var('ve_cultural_project_progress').GetValue|0] / 100"
									default_format = "#instruction"
									using = fontsize_xl
									align = nobaseline
									autoresize = yes
									visible = "[GetScriptedGui('ve_has_active_cultural_project_gui').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								}
								textbox = {
									raw_text = "([GetPlayer.MakeScope.ScriptValue('ve_monthly_cultural_project_progress')|+=0])"
									using = fontsize_small
									align = vcenter|nobaseline
									autoresize = yes
									visible = "[GetScriptedGui('ve_has_active_cultural_project_gui').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								}
								textbox = {
									text = "ve_no_active_cultural_project"
									default_format = "#instruction"
									using = fontsize_xl
									align = nobaseline
									autoresize = yes
									visible = "[GetScriptedGui('ve_has_no_active_cultural_project_gui').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								}
							}
							blockoverride "meter_bar" {
								white_progressbar_horizontal = {
									size = { 150 8 }
									blockoverride "values" {
										max = 100
										value = "[GetPlayer.MakeScope.Var('ve_cultural_project_progress').GetValue]"
									}
								}
							}
							blockoverride "meter_extra" {
								textbox = {
									raw_text = "[GetPlayer.GetCustom('ve_cultural_project_target')]"
									using = fontsize_small
									align = nobaseline
									maximumsize = { 240 -1 }
									elide = right
									autoresize = yes
									visible = "[GetScriptedGui('ve_has_active_cultural_project_gui').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								}
								textbox = { # only while a cancellation backlash blocks a new project
