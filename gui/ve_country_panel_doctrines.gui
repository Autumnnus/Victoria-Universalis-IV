						tooltip = "[GetScriptedGui('ve_age_bonus_12').ExecuteTooltip(GuiScope.SetRoot(Country.MakeScope).End)]"
					}
				}
				ve_cp_chip = {
					blockoverride "chip_icon" {
						texture = "gfx/interface/icons/generic_icons/prestige.dds"
					}
					blockoverride "chip_label" {
						raw_text = "13"
					}
					blockoverride "chip_state" {
						alpha = "[Select_float(GetScriptedGui('ve_cp_era_reward_13').IsShown(GuiScope.SetRoot(Country.MakeScope).End),'(float)1.0','(float)0.25')]"
					}
					blockoverride "chip_tooltip" {
						tooltip = "[GetScriptedGui('ve_age_bonus_13').ExecuteTooltip(GuiScope.SetRoot(Country.MakeScope).End)]"
					}
				}
			}
		}
	}
}
